{
  "license": "GPL-3.0-or-later",
  "tasks": {
    "dev": "VITE_SAROS_URL=http://localhost:7171 vite",
    "gen-docs": "deno run --allow-read --allow-write scripts/gen-docs.ts",
    "build": "deno task gen-docs && vite build",
    "preview": "vite preview",
    "check": "deno check src/main.tsx worker/og.ts",
    "lint": "deno lint src/ test/",
    "test": "deno test --allow-env=SAROS_E2E_URL,SAROS_E2E_TOKEN --allow-net test/",
    "deploy-worker": "deno run -A npm:wrangler deploy",
    "ci": "deno fmt --check src/ test/ && deno lint src/ test/ && deno task check && deno task build"
  },
  "imports": {
    "@ark-ui/solid": "npm:@ark-ui/solid@^5.39.3",
    "@inex/protobufs": "npm:@jsr/inex__protobufs@^0.3.0",
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@^2.16.0",
    "@connectrpc/connect": "npm:@connectrpc/connect@^2.2.0",
    "@connectrpc/connect-web": "npm:@connectrpc/connect-web@^2.2.0",
    "@solid-primitives/event-listener": "npm:@solid-primitives/event-listener@^2.4.6",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "@types/d3-force": "npm:@types/d3-force@^3.0.10",
    "@types/mdast": "npm:@types/mdast@^4.0.4",
    "d3-force": "npm:d3-force@^3.0.0",
    "mdast": "npm:@types/mdast@^4.0.4",
    "mdast-util-from-markdown": "npm:mdast-util-from-markdown@^2.1.0",
    "mdast-util-gfm": "npm:mdast-util-gfm@^3.1.0",
    "micromark-extension-gfm": "npm:micromark-extension-gfm@^3.0.0",
    "@solid-primitives/media": "npm:@solid-primitives/media@^2.3.6",
    "@solid-primitives/raf": "npm:@solid-primitives/raf@^2.3.5",
    "@solid-primitives/scheduled": "npm:@solid-primitives/scheduled@^1.5.3",
    "@solid-primitives/storage": "npm:@solid-primitives/storage@^4.4.0",
    "@solid-primitives/timer": "npm:@solid-primitives/timer@^1.4.4",
    "@tabler/icons-solidjs": "npm:@tabler/icons-solidjs@^3.49.0",
    "overlayscrollbars": "npm:overlayscrollbars@^2.16.0",
    "overlayscrollbars-solid": "npm:overlayscrollbars-solid@^0.5.6",
    "rolldown-plugin-solid": "npm:rolldown-plugin-solid@^0.2.1",
    "solid-js": "npm:solid-js@^1.9.17",
    "@solidjs/router": "npm:@solidjs/router@^1.0.0",
    "vite": "npm:vite@^8.3.4",
    "vite-plugin-solid": "npm:vite-plugin-solid@^2.11.14",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@simplewebauthn/browser": "npm:@simplewebauthn/browser@^14.0.0",
    "shiki": "npm:shiki@^4.5.0",
    "three": "npm:three@^0.186.1",
    "@types/three": "npm:@types/three@^0.186.0"
  },
  "fmt": {
    "exclude": [
      "src/lib/docs-generated.ts"
    ]
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  }
}
